# Root-level env used by Turborepo's `globalEnv`. Copy to .env (gitignored).
# Workspaces also have their own .env.example for app-specific defaults.

NODE_ENV=development

# Postgres connection string for packages/db and apps/api.
DATABASE_URL=postgres://tsundoku:tsundoku@localhost:5433/tsundoku

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-byte-hex-string-or-longer-secret

# OIDC (optional)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

PUBLIC_API_URL=http://localhost:6060
