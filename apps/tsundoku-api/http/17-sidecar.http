@baseUrl = http://localhost:6060
@username = admin
@password = admin123


### Login

POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  -- lua
  client.global.ACCESS_TOKEN = response.json.accessToken
%}


### Get sidecar content

GET {{baseUrl}}/api/v1/books/{{bookId}}/sidecar HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Get sidecar sync status

GET {{baseUrl}}/api/v1/books/{{bookId}}/sidecar/status HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Export to sidecar

POST {{baseUrl}}/api/v1/books/{{bookId}}/sidecar/export HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Import from sidecar

POST {{baseUrl}}/api/v1/books/{{bookId}}/sidecar/import HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Bulk export sidecar for library

POST {{baseUrl}}/api/v1/libraries/{{libraryId}}/sidecar/export-all HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Bulk import sidecar for library

POST {{baseUrl}}/api/v1/libraries/{{libraryId}}/sidecar/import-all HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
