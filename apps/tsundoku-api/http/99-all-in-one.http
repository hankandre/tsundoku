@baseUrl = http://localhost:6060
@username = admin
@password = admin123


### Login (run this first)

POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  -- lua
  local body = JSON.parse(response.body)
  if body.accessToken then
    client.global.set("token", body.accessToken)
    print("Token: " .. body.accessToken)
  end
%}


### Libraries (uses token from login above)

GET {{baseUrl}}/api/v1/libraries HTTP/1.1
Authorization: Bearer {{token}}


### Books (uses token from login above)

GET {{baseUrl}}/api/v1/books HTTP/1.1
Authorization: Bearer {{token}}


### User Stats (uses token from login above)

GET {{baseUrl}}/api/v1/user-stats/reading/dates HTTP/1.1
Authorization: Bearer {{token}}
