### 

@baseUrl = http://localhost:6060
@email = admin@example.com
@password = admin123
@username = admin


### Healthcheck

GET {{baseUrl}}/api/v1/healthcheck HTTP/1.1


### Version

GET {{baseUrl}}/api/v1/version HTTP/1.1


### Create user

POST {{baseUrl}}/api/v1/setup HTTP/1.1
Content-Type: application/json

{
  "email": "{{email}}",
  "name": "Admin",
  "password": "{{password}}",
  "username": "{{username}}"
}


### Setup status

GET {{baseUrl}}/api/v1/setup/status HTTP/1.1


### Login and save token

POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "password": "{{password}}",
  "username": "{{username}}"
}

> {%
  client.global.set("ACCESS_TOKEN", response.body.accessToken);
  client.global.set("REFRESH_TOKEN", response.body.refreshToken);
%}


### Get current user (requires auth)

GET {{baseUrl}}/api/v1/users/me HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Get all users (admin only)

GET {{baseUrl}}/api/v1/users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Logout (invalidate refresh token)

POST {{baseUrl}}/api/v1/auth/logout HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "refreshToken": "{{REFRESH_TOKEN}}"
}
