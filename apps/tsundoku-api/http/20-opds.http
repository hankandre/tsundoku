@baseUrl = http://localhost:6060
@username = admin
@password = admin123


### Login

POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  -- lua
  client.global.ACCESS_TOKEN = response.json.accessToken
%}


### Get OPDS root catalog

GET {{baseUrl}}/api/v1/opds HTTP/1.1
Accept: application/atom+xml


### Get OPDS libraries navigation

GET {{baseUrl}}/api/v1/opds/libraries HTTP/1.1
Accept: application/atom+xml


### Get OPDS shelves navigation

GET {{baseUrl}}/api/v1/opds/shelves HTTP/1.1
Accept: application/atom+xml


### Get OPDS magic shelves navigation

GET {{baseUrl}}/api/v1/opds/magic-shelves HTTP/1.1
Accept: application/atom+xml


### Get OPDS authors navigation

GET {{baseUrl}}/api/v1/opds/authors HTTP/1.1
Accept: application/atom+xml


### Get OPDS series navigation

GET {{baseUrl}}/api/v1/opds/series HTTP/1.1
Accept: application/atom+xml


### Get OPDS catalog feed

GET {{baseUrl}}/api/v1/opds/catalog HTTP/1.1
Accept: application/atom+xml


### Get recent books feed

GET {{baseUrl}}/api/v1/opds/recent HTTP/1.1
Accept: application/atom+xml


### Get surprise feed

GET {{baseUrl}}/api/v1/opds/surprise HTTP/1.1
Accept: application/atom+xml


### Get OpenSearch description

GET {{baseUrl}}/api/v1/opds/search.opds HTTP/1.1
Accept: application/opensearchdescription+xml


### Get book cover

GET {{baseUrl}}/api/v1/opds/{{bookId}}/cover HTTP/1.1


### Download book

GET {{baseUrl}}/api/v1/opds/{{bookId}}/download HTTP/1.1


### Get all OPDS users (admin)

GET {{baseUrl}}/api/v2/opds-users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Create OPDS user (admin)

POST {{baseUrl}}/api/v2/opds-users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "name": "OPDS User",
  "allowDownload": true,
  "allowUpload": false
}


### Update OPDS user (admin)

PATCH {{baseUrl}}/api/v2/opds-users/{{opdsUserId}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "Updated Name",
  "allowDownload": false
}


### Delete OPDS user (admin)

DELETE {{baseUrl}}/api/v2/opds-users/{{opdsUserId}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
