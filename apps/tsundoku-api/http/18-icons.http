@baseUrl = http://localhost:6060
@username = admin
@password = admin123


### Login

POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  -- lua
  client.global.ACCESS_TOKEN = response.json.accessToken
%}


### Get icon names (paginated)

GET {{baseUrl}}/api/v1/icons?page=0&size=20 HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Get SVG icon content

GET {{baseUrl}}/api/v1/icons/{{iconName}}/content HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Get all icons content

GET {{baseUrl}}/api/v1/icons/all/content HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}


### Save SVG icon (admin)

POST {{baseUrl}}/api/v1/icons HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "my-icon",
  "content": "<svg></svg>"
}


### Save batch SVG icons (admin)

POST {{baseUrl}}/api/v1/icons/batch HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "icons": [
    { "name": "icon1", "content": "<svg></svg>" },
    { "name": "icon2", "content": "<svg></svg>" }
  ]
}


### Delete SVG icon (admin)

DELETE {{baseUrl}}/api/v1/icons/{{iconName}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
