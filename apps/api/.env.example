# Copy to .env (gitignored) for local development.

NODE_ENV=development
BOOKLORE_PORT=6060
APP_VERSION=development

# CORS allowlist. Use a comma-separated list in production; "*" warns at boot.
ALLOWED_ORIGINS=http://localhost:5173

# MariaDB (same instance the Spring app uses).
DATABASE_URL=mysql://root:password@localhost:3306/booklore

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-byte-hex-string-or-longer-secret

# OIDC (optional)
# OIDC_ISSUER=https://example.com/realms/booklore
# OIDC_CLIENT_ID=booklore
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/auth/oidc/callback

# Remote-Auth (proxy/header-based; off by default)
REMOTE_AUTH_ENABLED=false

LOG_LEVEL=debug
