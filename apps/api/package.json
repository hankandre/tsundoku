{
  "name": "@tsundoku/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun --minify",
    "check": "tsc --noEmit",
    "lint": "echo 'lint: TODO'",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "@tsundoku/db": "workspace:*",
    "@types/nodemailer": "^8.0.0",
    "arktype": "^2.2.0",
    "bullmq": "^5.76.10",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.2",
    "hono": "^4.12.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.0",
    "music-metadata": "^11.12.0",
    "nodemailer": "^8.0.7",
    "openid-client": "^6.8.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/bun": "^1.3.4",
    "pino-pretty": "^13.1.0",
    "typescript": "^5.9.3"
  }
}
